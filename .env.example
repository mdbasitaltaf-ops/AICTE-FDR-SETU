# ==============================================================================
# AICTE FDR SETU - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# GEMINI_API_KEY: Required for server-side real multimodal document extraction (gemini-3.8-flash).
# Extract bank name, FDR number, depositor names, amount, dates, and lien clause with confidence scores.
# If omitted, the app will gracefully run in "Demo mode: simulated extraction".
GEMINI_API_KEY=""

# PORT: The HTTP port on which the Express + Vite server listens (defaults to 3000).
PORT=3000

# NODE_ENV: Set to "development" or "production".
NODE_ENV="development"

# APP_URL: Public URL where the application is hosted (e.g. https://aicte-fdr-setu.gov.in)
APP_URL="http://localhost:3000"
